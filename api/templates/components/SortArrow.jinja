{#def direction: str = "" #}

{% if direction == "up" %}
    <svg class="ns-sort-arrow"
         viewBox="0 0 12 12"
         fill="none"
         stroke="currentColor"
         stroke-width="1.6"
         aria-hidden="true">
        <path d="M6 10V2M3 5l3-3 3 3" />
    </svg>
{% elif direction == "down" %}
    <svg class="ns-sort-arrow"
         viewBox="0 0 12 12"
         fill="none"
         stroke="currentColor"
         stroke-width="1.6"
         aria-hidden="true">
        <path d="M6 2v8M3 7l3 3 3-3" />
    </svg>
{% endif %}
