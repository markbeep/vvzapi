{#def
    query: str,
    page: int,
    limit: int,
    order_by: QueryKey,
    order: str,
    results: SearchResponse | None = None,
    error: str | None = None,
#}

<div class="card bg-base-100 shadow-sm p-3 text-sm">
    <div class="flex flex-wrap items-center gap-2">
        <span class="font-bold">New results view</span>
        <span class="text-base-content/70">Compact table with plain-language filters.</span>
        <a href="/new?q={{ query|urlquote }}" class="btn btn-sm btn-outline">Try the new view</a>
        <a href="https://github.com/markbeep/vvzapi/issues/82"
           target="_blank"
           rel="noopener"
           class="btn btn-sm btn-ghost">Feedback</a>
    </div>
</div>

{% if error %}
    <div role="alert" class="text-center text-gray-500 mt-10">
        <p class="text-xs">
            {{ error|e }} · See the <a class="link" href="/guide">search guide</a>.
        </p>
    </div>
{% elif results.total %}
    <div class="text-gray-600">
        <p class="text-xs pb-2">
            Found {{ results.total }} relevant result{{ results.total|pluralize }}
            in {{ '%0.2f' % (results.exec_time_ms/1000) }}s where
            <span class="bg-base-100 py-0.5 px-1 rounded">{{ results.parsed_query|e }}</span>
        </p>

        <div class="collapse bg-base-100 border-base-300 border"
             aria-label="Search options">
            <input type="checkbox" />
            <div class="collapse-title">Search options</div>
            <div class="collapse-content text-sm">
                <div>
                    Showing
                    <select name="limit"
                            class="select select-ghost select-sm max-w-fit"
                            aria-label="Number of results to show">
                        <option value="20" {% if limit == 20 %}selected{% endif %}>20</option>
                        <option value="40" {% if limit == 40 %}selected{% endif %}>40</option>
                        <option value="60" {% if limit == 60 %}selected{% endif %}>60</option>
                        <option value="80" {% if limit == 80 %}selected{% endif %}>80</option>
                        <option value="100" {% if limit == 100 %}selected{% endif %}>100</option>
                    </select>
                    results ordered by
                    <select name="order_by"
                            class="select select-ghost select-sm max-w-fit"
                            aria-label="Order results by">
                        <option value="year" {% if order_by == "year" %}selected{% endif %}>newest offering</option>
                        <option value="title"
                                {% if order_by in ("title", "title_english") %}selected{% endif %}>English title</option>
                        <option value="title_german">German title</option>
                        <option value="number">number</option>
                        <option value="semester">semester</option>
                        <option value="lecturer">lecturer name</option>
                        <option value="department">department</option>
                        <option value="level">level</option>
                        <option value="language">language</option>
                        <option value="coursereview">CourseReview rating</option>
                    </select>
                    <select name="order"
                            class="select select-ghost select-sm max-w-fit"
                            aria-label="Order direction">
                        <option value="asc" {% if order != "desc" %}selected{% endif %}>ascending</option>
                        <option value="desc" {% if order == "desc" %}selected{% endif %}>descending</option>
                    </select>
                </div>

                <script>
                    // Descending is the useful default for "newest" and ratings; the
                    // other keys read better ascending.
                    const orderDefaults = {
                        year: 'desc',
                        coursereview: 'desc'
                    };
                    const setOpts = () => {
                        const inputs = document.querySelectorAll('select[name="limit"], select[name="order_by"], select[name="order"]');
                        const currentUrl = new URL(window.location);
                        const params = currentUrl.searchParams;
                        inputs.forEach(input => {
                            const paramValue = params.get(input.name);
                            if (paramValue) {
                                input.value = paramValue;
                            }
                            input.addEventListener('change', (event) => {
                                const url = new URL(window.location);
                                url.searchParams.set(event.target.name, event.target.value);
                                if (event.target.name === 'order_by') {
                                    const orderInput = document.querySelector('select[name="order"]');
                                    const nextOrder = orderDefaults[event.target.value] ?? 'asc';
                                    orderInput.value = nextOrder;
                                    url.searchParams.set('order', nextOrder);
                                }
                                url.searchParams.set('page', '1');
                                window.location.href = url.toString();
                            });

                        });
                    }
                    document.addEventListener('DOMContentLoaded', setOpts);
                    document.addEventListener('fx:swapped', setOpts);
                </script>
            </div>
        </div>
    </div>

    {% if results.total > results.results|length %}
        {# djlint:off #}
        <Pagination query={{ query }} page={{ page }} limit={{ limit }} order_by={{ order_by }} order={{ order }} results={{ results }} prefetch_next_page={{ True }} />
        {# djlint:on #}
    {% endif %}

    {% for _, grouped in results %}
        {# djlint:off #}
        <BigResult grouped={{ grouped }}  query={{ query }} />
        {# djlint:on #}
    {% endfor %}

    {% if results.total > results.results|length %}
        {# djlint:off #}
        <Pagination query={{ query }} page={{ page }} limit={{ limit }} order_by={{ order_by }} order={{ order }} results={{ results }} />
        {# djlint:on #}
    {% endif %}

{% else %}
    <div class="text-center text-gray-500 mt-10">
        <p class="text-xs">
            No results found where
            <span class="bg-base-100 py-0.5 px-1 rounded">{{ results.parsed_query }}</span>
        </p>
    </div>
{% endif %}
