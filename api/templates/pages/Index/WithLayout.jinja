{#def
    query: str,
    page: int,
    limit: int,
    order_by: QueryKey,
    order: str,
    results: SearchResponse | None = None,
    error: str | None = None,
#}

{# djlint:off #}
<SearchLayout query={{ query }} title={{ query + " - VVZ API" }} description={{ "Search results for " + query }}>
{# djlint:on #}

<main class="grow p-4 sm:p-8">
    <div id="results" class="flex flex-col max-w-5xl mx-auto space-y-4">{# djlint:off #}
        <Index.Results query={{ query }} page={{ page }} limit={{ limit }} order_by={{ order_by }} order={{ order }} results={{ results }} error={{ error }} />
        {# djlint:on #}</div>
</main>

</SearchLayout>
